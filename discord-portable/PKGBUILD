pkgname=discord-portable
_pkgname=Discord
pkgver=1.0.158
pkgrel=1
epoch=1
pkgdesc="All-in-one voice and text chat for gamers. Sandboxed for privacy."
arch=('x86_64')
url='https://discord.com'
license=('LicenseRef-Discord')
conflicts=("discord")
makedepends=('portable-packer' 'discord')
provides=("discord" "discord-sandbox")
depends=('libnotify' 'libxss' 'nspr' 'nss' 'gtk3' 'libpulse' 'libappindicator-gtk3' 'portable')
options=(!debug !strip)
replaces=('discord-bwrap')
source=(
	"config.toml"
	"discord.sh"
	"discord.desktop"
)
sha512sums=('0e0f282b6e477a451c9c8953e2136b063b63c73795a51f46e18def94a71789c8dd130951fdabf8886452f282260f433c4a2bc2d81aa06253689e62b0e4453358'
            '2da93993b75de7a39e67cad90292193f5d508b38574b189a67a05592226acce2dbaffc6217a8727a52077a7c0b5ba75eaddf7f99bd1e129f6f91be150003a351'
            '49510ad918b8e85fe83a7967f02486fad9ab622ebb50f0c7c3e03606b3ade3f31c19bde4791968082829b5a47c82152fa3b6c7019c8fb7359f77b24f0483d049')

package() {
	export pkgdir
	export pkgname
	export srcdir
	portable-packer \
		-v \
		--distro arch \
		--mode copy discord \
		--hash true \
		--config-ng "${srcdir}/config.toml" \
		--desktop-file "${srcdir}/discord.desktop"
}
