# Maintainer: Qingxu <me@linioi.com>
# Contributor: RiverOnVenus <aur@zhui.dev>

pkgname=herdr-core-bin
pkgver=0.1.21
pkgrel=1
pkgdesc='Background server that keeps Herdr terminals and coding agents running'
arch=('x86_64')
options=('!debug')
url='https://herdr.dev/core/'
license=('Apache-2.0')
depends=()
optdepends=('openssh: reach other machines over SSH')
provides=("herdr-core=$pkgver")
conflicts=('herdr-core' 'hc-bin')
# Literal arch names, not $CARCH: .SRCINFO is generated on one host but must
# carry the real asset URL.
source_x86_64=("${pkgname%-bin}-${pkgver}-x86_64.tar.gz::https://releases.herdr.dev/core/${pkgver}/herdr-core-linux-x86_64.tar.gz")
sha256sums_x86_64=('78424755c10a40dde38a0bdb55c20ac19706e9ae05ed68fc2acf1fcff0d941c1')

package() {
  install -Dm755 "$srcdir/herdr-core" "$pkgdir/usr/bin/herdr-core"
  ln -s herdr-core "$pkgdir/usr/bin/hc"

  install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/THIRD-PARTY-NOTICES" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY-NOTICES"
}
