# Maintainer: czyt <czytcn@gmail.com>
# Contributor: RiverOnVenus <aur@zhui.dev>

pkgname=magpie-bin
pkgver=0.1.3116
pkgrel=2
pkgdesc="One place to pick every AI coding agent's model"
arch=('x86_64' 'aarch64')
url='https://usemagpie.ai'
license=('MIT')
depends=(
  'fontconfig'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'libx11'
  'wayland'
  'webkit2gtk-4.1'
)
conflicts=('magpie')
options=('!debug')

source=(
  "magpie-${pkgver}.LICENSE::https://raw.githubusercontent.com/yetone/magpie/v${pkgver}/LICENSE"
  "magpie-${pkgver}.THIRD_PARTY_NOTICES::https://raw.githubusercontent.com/yetone/magpie/v${pkgver}/THIRD_PARTY_NOTICES"
  "magpie-${pkgver}.png::https://raw.githubusercontent.com/yetone/magpie/v${pkgver}/internal/gui/icon-256.png"
)
source_x86_64=(
  "magpie-${pkgver}-amd64::https://github.com/yetone/magpie-releases/releases/download/v${pkgver}/magpie-linux-amd64"
)
source_aarch64=(
  "magpie-${pkgver}-arm64::https://github.com/yetone/magpie-releases/releases/download/v${pkgver}/magpie-linux-arm64"
)
sha256sums=('79d2c8444715d4bc453ec4f8a0aaf2051a4c1ee5ac08f5bd2e5848aef87c7572'
            '7367c36421134228559c2d1dd8305da757dd08bacc5d620cd36b65b355dcb7e3'
            '57437c6596e05a8fcfc42d4288c030aa00ed86b69fe35d464d69d7026150c704')
sha256sums_x86_64=('825087563cafa7b3c6e3317fdfc5551a376b206617ff553848948c56824363f3')
sha256sums_aarch64=('48ae86844818177d48c2748650e4cbab367aa8ad4e9690d69818b37f61814aa8')

package() {
  local _suffix
  case "$CARCH" in
    x86_64)  _suffix=amd64 ;;
    aarch64) _suffix=arm64 ;;
  esac

  install -Dm755 "${srcdir}/magpie-${pkgver}-${_suffix}" "${pkgdir}/usr/bin/magpie"

  install -Dm644 "${srcdir}/magpie-${pkgver}.png" \
    "${pkgdir}/usr/share/icons/hicolor/256x256/apps/magpie.png"
  install -Dm644 "${srcdir}/magpie-${pkgver}.LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  # Upstream states the moejs and V8 code it covers is compiled into every binary.
  install -Dm644 "${srcdir}/magpie-${pkgver}.THIRD_PARTY_NOTICES" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES"

  install -dm755 "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/magpie.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Magpie
Comment=Every agent's model. One place.
Exec=/usr/bin/magpie app
Icon=magpie
Categories=Development;
Terminal=false
EOF
}
