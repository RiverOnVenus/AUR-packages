# Maintainer: RiverOnVenus <aur@zhui.dev>

pkgname=alma-desktop-bin
pkgver=0.4.321
pkgrel=1
pkgdesc='AI provider orchestration desktop app'
arch=('x86_64')
url='https://alma.now'
license=('LicenseRef-custom')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'bash'
  'cairo'
  'dbus'
  'expat'
  'gcc-libs'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libgomp'
  'libnotify'
  'libsecret'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'vulkan-icd-loader'
  'xdg-utils'
)
optdepends=(
  'java-runtime: run Java-based MCP servers'
  'nodejs: run Node.js-based MCP servers'
  'python: run Python-based MCP servers'
)
provides=('alma-desktop')
conflicts=('alma-appimage')
source=("https://github.com/yetone/alma-releases/releases/download/v${pkgver}/alma-${pkgver}-linux-amd64.deb")
sha256sums=('f3c6b1ae0211506996c0a9f46f103dc7f579a47a47a38477bdd19e0885a49733')

prepare() {
  bsdtar -xf "${srcdir}/alma-${pkgver}-linux-amd64.deb" -C "${srcdir}" data.tar.xz
  mkdir -p "${srcdir}/payload"
  bsdtar -xf "${srcdir}/data.tar.xz" -C "${srcdir}/payload"
}

package() {
  cp -a --no-preserve=ownership "${srcdir}"/payload/usr "${srcdir}"/payload/opt "${pkgdir}"/

  # The Debian postinst creates this alternative; skip it and the CLI entry point is missing.
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/Alma/alma "${pkgdir}/usr/bin/alma"

  install -Dm644 "${srcdir}/payload/opt/Alma/LICENSE.electron.txt" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE.electron.txt"
  install -Dm644 "${srcdir}/payload/opt/Alma/LICENSES.chromium.html" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSES.chromium.html"
}
