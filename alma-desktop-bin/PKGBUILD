# Maintainer: huochenghai <huochenghai@gmail.com>
# Contributor: RiverOnVenus <aur@zhui.dev>

pkgname=alma-desktop-bin
pkgver=0.4.567
pkgrel=1
pkgdesc='AI provider orchestration desktop app'
arch=('x86_64')
url='https://alma.now'
license=('LicenseRef-custom')
depends=(
  'gcc-libs'
  'gtk3'
  'hicolor-icon-theme'
  'webkit2gtk-4.1'
)
optdepends=(
  'java-runtime: run Java-based MCP servers'
  'nodejs: run Node.js-based MCP servers'
  'python: run Python-based MCP servers and the screen sharing helper'
  'python-gobject: share this screen through xdg-desktop-portal'
  'gst-plugin-pipewire: screen sharing stream source'
  'gst-plugins-good: JPEG screen frames (optional, lower CPU)'
  'libsecret: store provider credentials in the system keyring'
)
provides=('alma-desktop')
conflicts=('alma-appimage')
source=("https://github.com/yetone/alma-releases/releases/download/v${pkgver}/alma-${pkgver}-linux-amd64.deb")
sha256sums=('b839211c2ab62e26f47df11b5ab37898a9d72077dde09b61838f12366104e909')

prepare() {
  # The payload member was data.tar.xz before 0.4.5xx; upstream now ships data.tar.gz.
  bsdtar -xf "${srcdir}/alma-${pkgver}-linux-amd64.deb" -C "${srcdir}" 'data.tar.*'
  local data=("${srcdir}"/data.tar.*)
  install -dm755 "${srcdir}/payload"
  bsdtar -xf "${data[0]}" -C "${srcdir}/payload"
}

package() {
  cp -a --no-preserve=ownership "${srcdir}"/payload/usr "${srcdir}"/payload/opt "${pkgdir}"/

  # The Debian postinst creates this alternative; skip it and the CLI entry point is missing.
  install -d "${pkgdir}/usr/bin"
  ln -s /opt/alma/alma "${pkgdir}/usr/bin/alma"

  install -Dm644 "${srcdir}/payload/opt/alma/THIRD_PARTY_NOTICES.md" \
    "${pkgdir}/usr/share/licenses/${pkgname}/THIRD_PARTY_NOTICES.md"
}
