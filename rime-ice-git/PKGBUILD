# Maintainer: everyx <lunt.luo#gmail.com>
# Contributor: Julien Virey <julien.virey@gmail.com>
#
# 单包版本：只出 rime-ice-git 一个包，只装全拼方案（rime_ice）及其依赖。
# 构建逻辑取自 AUR 上 everyx 的 split PKGBUILD，合并了各方案共用的部分。
# default.yaml 与 rime-prelude 的 /usr/share/rime-data/default.yaml 同名，
# 因此改名成 _default.yaml，安装时作为 rime_ice_suggestion.yaml 提供。

pkgname=rime-ice-git
_gitname=rime-ice
pkgver=r1006.927e1cf
pkgrel=2
pkgdesc='Rime 配置：雾凇拼音 | 长期维护的简体词库'
arch=('any')
url='https://github.com/iDvel/rime-ice'
license=('GPL-3.0-or-later')
depends=('lua' 'librime')
makedepends=('git' 'rime-prelude')
provides=('rime-ice')
conflicts=(
  'rime-emoji'
  'rime-double-pinyin'
  'rime-ice-pinyin'
  'rime-ice-double-pinyin'
  'rime-ice-double-pinyin-abc'
  'rime-ice-double-pinyin-mspy'
  'rime-ice-double-pinyin-sogou'
  'rime-ice-double-pinyin-flypy'
  'rime-ice-double-pinyin-ziguang'
  'rime-ice-double-pinyin-jiajia'
)
install="$pkgname.install"
source=("${_gitname}::git+${url}.git")
sha256sums=('SKIP')

# 参与编译和安装的方案，只有全拼。melt_eng（英文输入）和 radical_pinyin
# （部件拆字）挂在 rime_ice.schema.yaml 的 dependencies 里，必须一起装
_schemas=(
  melt_eng
  radical_pinyin
  rime_ice
)

pkgver() {
  cd "$_gitname"
  printf 'r%s.%s' "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_gitname"

  # 不安装上游的 default.yaml，改名后单独处理（重跑构建时 _default.yaml 已存在）
  if [[ -f default.yaml && ! -L default.yaml ]]; then
    mv default.yaml _default.yaml
  fi

  # 方案列表只保留全拼。t9 面向移动端九键，双拼方案本包不带，
  # 留在列表里会让部署报找不到方案。行尾带注释，所以不锚定行尾
  sed -i -E 's/^  - schema: (t9|double_pinyin[a-z_]*)/  # - schema: \1/' _default.yaml

  # rime_deployer 需要 default.yaml 及其引用的 prelude 文件
  local _f
  for _f in $(pacman -Qql rime-prelude | grep -v '/$'); do
    ln -sf "$_f" .
  done
}

build() {
  cd "$_gitname"
  local _s
  for _s in "${_schemas[@]}"; do
    rime_deployer --compile "${_s}.schema.yaml"
  done
  # prelude 的符号链接只在构建期间需要
  find . -maxdepth 1 -type l -delete
}

package() {
  cd "$_gitname"
  local _dir="$pkgdir/usr/share/rime-data"
  local _s

  # 方案与词库
  install -Dm644 -t "$_dir" \
    rime_ice.schema.yaml rime_ice.dict.yaml \
    melt_eng.schema.yaml melt_eng.dict.yaml \
    radical_pinyin.schema.yaml radical_pinyin.dict.yaml \
    symbols_v.yaml symbols_caps_v.yaml

  # 方案列表预设，用户目录的 default.custom.yaml 通过 __include 引入
  install -Dm644 _default.yaml "$_dir/rime_ice_suggestion.yaml"

  # 词库源文件、lua 过滤器、opencc 词表
  cp -a cn_dicts en_dicts lua opencc "$_dir/"
  if [[ -f rime.lua ]]; then
    install -Dm644 rime.lua "$_dir/rime.lua"
  fi

  # 预编译产物，省掉首次部署的编译时间
  for _s in "${_schemas[@]}"; do
    install -Dm644 build/"${_s}".*.{bin,yaml} -t "$_dir/build"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

# vim: sw=2 ts=2 et:
